# The qa-scripter agent copies this template to .env at bootstrap (Phase 0) if .env is missing.
# You only fill in the values (credentials + URLs) - those can't be invented.
# .env is gitignored - never commit real credentials.

# App under test - BASE_URL is what Playwright uses; point it at one environment below
BASE_URL=

# Environments (user app / admin app)
DEV_URL=
DEV_ADMIN_URL=
PILOT_URL=
PILOT_ADMIN_URL=
PROD_URL=
PROD_ADMIN_URL=

# Default-role credentials (used by global-setup.ts to produce .auth/user.json)
EMAIL=
PASSWORD=
# MOBILE=                # only if the app uses phone/OTP login

# Multi-role credentials (added at onboarding when roles are known) - one pair per role,
# consumed by global-setup.ts to produce .auth/<role>.json:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# CUSTOMER_EMAIL=
# CUSTOMER_PASSWORD=

# Per-environment credentials (users: email + password; admin: email + token)
DEV_USER1_EMAIL=
DEV_USER1_PASSWORD=
DEV_USER2_EMAIL=
DEV_USER2_PASSWORD=
DEV_ADMIN_EMAIL=
DEV_ADMIN_TOKEN=
PILOT_USER1_EMAIL=
PILOT_USER1_PASSWORD=
PILOT_USER2_EMAIL=
PILOT_USER2_PASSWORD=
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_TOKEN=
PROD_USER1_EMAIL=
PROD_USER1_PASSWORD=
PROD_USER2_EMAIL=
PROD_USER2_PASSWORD=
PROD_ADMIN_EMAIL=
PROD_ADMIN_TOKEN=

# API Setup Layer (only if a module uses API seeding/teardown)
# API_BASE_URL=          # auth reuses the .auth/<role>.json session
