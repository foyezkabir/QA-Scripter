{
  "module": "Admin Users",
  "route": "/admin/users",
  "createdAt": "2026-10-08",
  "updatedAt": "2026-10-08",
  "buildRef": "DEV https://admin.dev.app.velaops.ai (no ticket)",
  "headings": [
    "Users",
    "Total users",
    "Active",
    "Unverified",
    "Suspended",
    "All users"
  ],
  "tabs": [],
  "states": [
    {
      "name": "populated",
      "reached": true,
      "how": "95 user rows with stat cards, live text and a per-row Actions menu"
    },
    {
      "name": "empty",
      "reached": true,
      "how": "a nonsense search shows 'No users match these filters' with a Clear filters button"
    },
    {
      "name": "loading",
      "reached": true,
      "how": "Top up credit and detail dialogs fill from the row; no separate loading state held"
    },
    {
      "name": "error",
      "reached": false,
      "why": "list error state needs a backend failure; not forced on shared Dev"
    },
    {
      "name": "disabled",
      "reached": true,
      "how": "on the signed-in admin's own row Demote to user and Suspend are disabled"
    },
    {
      "name": "role-gated:unauthenticated",
      "reached": true,
      "how": "logged out, /admin/users redirects to /admin/login"
    },
    {
      "name": "role-gated:authenticated",
      "reached": true,
      "how": "the saved admin session opens the page"
    },
    {
      "name": "terminal",
      "reached": false,
      "why": "Promote, Demote, Reinstate, Top up and Suspend change shared accounts and fire without any confirmation or are confirm-buttons; only the dialogs are opened and cancelled"
    }
  ],
  "tables": [
    {
      "name": "All users",
      "columns": [
        "User",
        "Role",
        "Status",
        "Agents",
        "LiteLLM Key",
        "Created",
        "Actions"
      ],
      "rowActions": [
        "Actions for <user name>"
      ]
    }
  ],
  "fields": [
    {
      "label": "Search users by name, email or role",
      "type": "searchbox",
      "urlParam": "q"
    },
    {
      "label": "Chat tool view",
      "type": "combobox",
      "region": "User detail dialog",
      "options": [
        "Inherit default (detailed)",
        "Compact",
        "Detailed",
        "Off"
      ],
      "state": "NOT changed"
    },
    {
      "label": "Amount (USD)",
      "type": "spinbutton",
      "region": "Top up credit dialog",
      "default": "20"
    },
    {
      "label": "Note (optional)",
      "type": "textbox",
      "region": "Top up credit dialog",
      "placeholder": "Why are you topping up?"
    },
    {
      "label": "Reason (stored on the account)",
      "type": "textbox",
      "region": "Suspend dialog",
      "default": "Violation of terms of service"
    },
    {
      "label": "Expires (optional)",
      "type": "textbox",
      "region": "Suspend dialog",
      "state": "empty means an indefinite suspension"
    }
  ],
  "actions": [
    {
      "role": "button",
      "name": "All",
      "region": "status filter",
      "state": "pressed by default"
    },
    {
      "role": "button",
      "name": "Active",
      "region": "status filter",
      "state": "sets ?status=active"
    },
    {
      "role": "button",
      "name": "Unverified",
      "region": "status filter",
      "state": "sets ?status=unverified"
    },
    {
      "role": "button",
      "name": "Suspended",
      "region": "status filter",
      "state": "sets ?status=suspended"
    },
    {
      "role": "button",
      "name": "Clear filters",
      "region": "empty state"
    },
    {
      "role": "button (row menu)",
      "name": "Actions for <user name>",
      "region": "row",
      "opens": {
        "items": [
          "View details",
          "Promote to admin",
          "Demote to user",
          "Refresh LiteLLM limits",
          "Top up credit",
          "Suspend",
          "Reinstate"
        ]
      }
    },
    {
      "role": "button",
      "name": "Close",
      "region": "every dialog"
    },
    {
      "role": "button",
      "name": "Cancel",
      "region": "Top up credit and Suspend dialogs"
    },
    {
      "role": "button",
      "name": "Add $20.00",
      "region": "Top up credit dialog",
      "state": "adds credit; NOT clicked"
    },
    {
      "role": "button",
      "name": "Suspend account",
      "region": "Suspend dialog",
      "state": "suspends the account; NOT clicked"
    },
    {
      "role": "link",
      "name": "Top up",
      "region": "credit banner, only while credit is low",
      "state": "leaves for openrouter.ai; NOT clicked"
    },
    {
      "role": "button",
      "name": "Dismiss",
      "region": "credit banner, only while credit is low",
      "state": "NOT clicked"
    }
  ],
  "icons": [
    {
      "name": "Signups per day over the last 7 days",
      "type": "sparkline image",
      "region": "Total users card"
    },
    {
      "name": "Accounts active today, by the day they signed up, over the last 7 days",
      "type": "sparkline image",
      "region": "Active card"
    },
    {
      "name": "Accounts still unverified, by the day they signed up, over the last 7 days",
      "type": "sparkline image",
      "region": "Unverified card"
    },
    {
      "name": "Accounts suspended per day over the last 1 day the audit feed reached",
      "type": "sparkline image",
      "region": "Suspended card"
    }
  ],
  "messages": [
    {
      "kind": "info",
      "text": "Promote, demote, suspend and inspect every account.",
      "role": "none (plain text)"
    },
    {
      "kind": "info",
      "text": "Live · 95 users · re-reads on focus",
      "role": "none (plain text)"
    },
    {
      "kind": "info",
      "text": "activity covers the last 1 day, not 7 - the audit feed caps at 500 events",
      "role": "none (plain text)"
    },
    {
      "kind": "empty",
      "text": "No users match these filters",
      "role": "none (plain text)"
    },
    {
      "kind": "info",
      "text": "OpenRouter credit running low. $<amount> remaining - top up to avoid agent interruptions.",
      "role": "none (plain text)",
      "note": "only while credit is under the reminder line"
    }
  ],
  "modals": [
    {
      "name": "User detail",
      "trigger": "View details",
      "fields": [
        "Status",
        "Role",
        "Agents owned",
        "Two-factor",
        "LiteLLM key",
        "Created",
        "Chat tool view"
      ],
      "actions": [
        "Close"
      ]
    },
    {
      "name": "Top up credit",
      "trigger": "Top up credit",
      "actions": [
        "Close",
        "Cancel",
        "Add $20.00"
      ]
    },
    {
      "name": "Suspend this account?",
      "trigger": "Suspend",
      "actions": [
        "Close",
        "Cancel",
        "Suspend account"
      ]
    }
