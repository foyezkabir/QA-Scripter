  "changelog": [
    {
      "date": "2026-10-08",
      "note": "Initial capture on the project 'Pilot Release QA - Oct 2026' as user 1. Task counts, people, activity, rounds and the saved views, digest and budget are live shared data and never asserted by value. The project chat is not used: sending spends the assistant's budget. Nothing was created, saved, started, finished or deleted."
    },
    {
      "date": "2026-10-09",
      "note": "Mutations added with full access: only disposable QA-AUTO Team projects are created and tasks are added inside them; the project is moved to the trash and deleted forever after each test. The existing project 'Pilot Release QA - Oct 2026' is still only read."
    }
  ]
