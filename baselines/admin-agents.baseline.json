    {
      "name": "populated",
      "reached": true,
      "how": "24+ agent rows with stat cards, live polling text and per-row Actions menu"
    },
    {
      "name": "empty",
      "reached": true,
      "how": "a nonsense search shows 'No agents match these filters' with a Clear filters button; the Error filter showed the same empty state when no agent was in error"
    },
    {
      "name": "loading",
      "reached": true,
      "how": "View logs dialog shows 'Fetching logs…' with Refresh and Load more disabled; detail dialog Storage shows 'Loading usage…'"
    },
    {
      "name": "error",
      "reached": false,
      "why": "Agents list error state needs a backend failure; not forced on shared Dev"
    },
    {
      "name": "disabled",
      "reached": true,
      "how": "Reset to default is disabled while the quota is the inherited default; Refresh disabled while logs load"
    },
    {
      "name": "role-gated:authenticated",
      "reached": true,
      "how": "page is reachable only with the admin session; logged out it redirects to /admin/login"
    },
    {
      "name": "terminal",
      "reached": false,
      "why": "Delete, Reprovision and Deploy are terminal and state-changing; only the dialogs and menu are opened"
    }
  ],
